# Serverni ishga tushirish porti
PORT=3000

# JWT imzolash uchun maxfiy kalit — buni albatta o'zgartiring
JWT_SECRET=juda-maxfiy-va-uzun-random-satr

# Gmail orqali OTP kod yuborish uchun (ixtiyoriy — sozlanmasa, kod terminalga chiqariladi)
# 1. Google akkauntingizda 2 bosqichli tasdiqlashni yoqing: https://myaccount.google.com/security
# 2. "App passwords" bo'limidan 16 xonali maxsus parol generatsiya qiling:
#    https://myaccount.google.com/apppasswords
# 3. Oddiy Gmail parolingizni EMAS, aynan shu 16 xonali App Password'ni pastga yozing
GMAIL_USER=sizning-emailingiz@gmail.com
GMAIL_PASS=16-xonali-app-password

# (Ixtiyoriy) Yangi buyurtma tushganda shu manzilga email ham boradi — bo'sh qoldirsangiz, email yuborilmaydi
NOTIFY_EMAIL=sizning-emailingiz@gmail.com

# (Tavsiya etiladi) Telegram bot orqali buyurtma haqida darhol xabar olish uchun:
# 1. Telegram'da @BotFather ga yozing, /newbot buyrug'ini yuboring, bot yarating — u sizga TOKEN beradi
# 2. Shu botga o'zingiz /start deb yozing (bot siz bilan yozishmagan bo'lsa xabar yubora olmaydi)
# 3. Chat ID'ingizni bilish uchun @userinfobot ga yozing — u sizga ID raqamingizni beradi
TELEGRAM_BOT_TOKEN=1234567890:AAxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TELEGRAM_CHAT_ID=123456789

NODE_ENV=development
